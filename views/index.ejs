<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Főoldal</h1>
    <table>
        <thead>
            <th>Termék neve</th>
            <th>Kategória</th>
            <th>Ár</th>
            <th>Raktárkészlet</th>
        </thead>
        <tbody>
            <% Product.forEach(a=> { %>
                <tr class="<%= a.stock === 0 ? "kifogyott" : '' %>" >
                    <td >
                        <%= a.name %>
                    </td>
                    <td>
                        <%= a.category %>
                    </td>
                    <td>
                        <%= a.price %>
                    </td>
                    <td class="<%= a.stock < 5 ? "kevesvan" : '' %>" ><%= a.stock %></td>
              </tr>
              
              <% }) %>

              <a href="/filter">filter</a>
              <br>
              <a href="/new">newProduct</a>
              <br>
              <br>
       </tbody>
    </table>
</body>
</html>